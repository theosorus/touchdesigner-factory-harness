    - 0.67
    inputs:
    - MorphShape
  - name: MorphShape
    type: glslPOP
    parameters:
      computedat: MorphShape_compute
      outputattrs: '*'
    sequences:
      attr:
      - name: color
        numcomps: '4'
      vec:
      - name: u_shapetarget
        valuex: =op('InCtrl')['shapetarget']
      - name: u_morph
        valuex: =op('InCtrl')['morph']
      - name: u_chaos
        valuex: =op('InCtrl')['chaos']
      - name: u_palettephase
        valuex: =op('InCtrl')['palettephase']
      - name: u_paletteshift
        valuex: =op('..').parent().op('render').par.Paletteshift.eval()
    position:
    - 400
