    - 90
    color:
    - 0.67
    - 0.67
    - 0.67
    inputs:
    - delete_decimate
  - name: pointfilein_surface
    type: pointfileinPOP
    parameters:
      file: assets/brain_surface.ply
      colorfields: ''
    size:
    - 130
    - 90
    color:
    - 0.67
    - 0.67
    - 0.67
  annotations:
  - name: annotate1
    mode: annotate
    title: Brain surface cloud
    text: 'Loads assets/brain_surface.ply (215601 SURFACE points with their normals, converted from brain.glb by scripts/glb_to_ply.py),
      adds a random seed per point, and decimates by deleting points whose seed exceeds the Density threshold. No rotation
      to apply: the converter already outputs Y-up, centred and scaled.'
    position:
    - -70
    - -70
    size:
    - 1870
    - 330
    color:
    - 0.45
    - 0.45
    - 0.45
