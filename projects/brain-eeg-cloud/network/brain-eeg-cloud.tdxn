  - name: glsl_pulse_compute
    type: textDAT
    parameters:
      file: project1/fx_pulse/glsl_pulse_compute.glsl
      syncfile: true
      language: glsl
    flags:
    - viewer
    position:
    - 325
    - -120
    size:
    - 130
    - 90
    color:
    - 0.9
    - 0.3
    - 0.4
    tags:
    - glsl
    dock: glsl_pulse
    dat_content: "// fx_pulse -- breathing, activity focus, lighting and colour of the brain point cloud.\n//\n// The cloud\
      \ comes from a SURFACE mesh, so every point carries the real normal of the\n// cortical skin. Three depth cues follow\
      \ from that, and it is their absence that made\n// the rotation direction ambiguous (kinetic depth ambiguity, the Necker\
      \ cube family):\n//   1. the back face is REMOVED, not dimmed;\n//   2. brightness decreases with distance to the camera;\n\
      //   3. the lighting model rotates with the object.\n// Depth-buffer occlusion, the fourth cue, is a setting on the\
      \ MAT.\n//\n// Uniforms provided by the GLSL POP's vec sequence:\n//   uSignal = (alpha, beta, theta, 0)\n//   uCtrl\
      \   = (Breath, Dispersion, Warmth, time in seconds)\n//   uZone   = (focus travel period, Zonesize, Activity, 0)\n//\
      \   uCam    = (camera xyz position, Depthfade)\n// In: P, N, Seed (0-1, unique per point). Out: displaced P and premultiplied\
      \ Color.\n\nvec3 hash3(float n)\n{\n\treturn fract(sin(vec3(n, n + 1.7, n + 3.3)) * vec3(43758.5453, 22578.1459, 19642.3490))\
      \ * 2.0 - 1.0;\n}\n\n// Centre of the activity focus: it jumps to a new position every period, with a smooth\n// interpolation\
      \ so the move reads as a propagation rather than a cut.\nvec3 zoneCenter(float t, float period)\n{\n\tfloat slot = floor(t\
      \ / period);\n\tfloat f = smoothstep(0.0, 1.0, fract(t / period));\n\tvec3 a = hash3(slot * 11.0 + 3.0);\n\tvec3 b =\
      \ hash3((slot + 1.0) * 11.0 + 3.0);\n\treturn mix(a, b, f) * vec3(0.62, 0.60, 0.85);\n}\n\nvoid main()\n{\n\tconst uint\
      \ id = TDIndex();\n\tif (id >= TDNumElements())\n\t\treturn;\n\n\tvec3 p = TDIn_P();\n\tvec3 n = normalize(TDIn_N());\n\
      \tfloat seed = TDIn_Seed();\n\n\tfloat alpha = uSignal.x;\n\tfloat beta = uSignal.y;\n\tfloat theta = uSignal.z;\n\t\
      float breathAmt = uCtrl.x;\n\tfloat disperseAmt = uCtrl.y;\n\tfloat violetAmt = uCtrl.z;\n\tfloat t = uCtrl.w;\n\tfloat\
      \ zonePeriod = max(uZone.x, 0.5);\n\tfloat zoneRadius = max(uZone.y, 0.05);\n\tfloat activityAmt = uZone.z;\n\tvec3\
      \ camPos = uCam.xyz;\n\tfloat depthFade = uCam.w;\n\n\t// Breathing: the surface swells along its own normal, phase-shifted\
      \ per point.\n\tfloat phase = seed * 6.2831853;\n\tfloat slow = sin(t * 0.55 + phase);\n\tfloat fast = sin(t * 1.70\
      \ + phase * 2.3);\n\tfloat breath = 0.5 + 0.5 * (0.75 * slow + 0.25 * fast);\n\tfloat amp = breathAmt * 0.09 * (0.35\
      \ + 0.65 * alpha);\n\tvec3 disp = n * amp * breath;\n\n\t// One activity focus at a time: it travels through the volume\
      \ and breathes on its own\n\t// rhythm. Nearby points light up and are pushed outward.\n\tvec3 zc = zoneCenter(t, zonePeriod);\n\
      \tfloat zd = length(p - zc);\n\tfloat zw = exp(-(zd * zd) / (zoneRadius * zoneRadius));\n\tfloat pulse = 0.45 + 0.55\
      \ * (0.5 + 0.5 * sin(t * 1.25));\n\tfloat act = clamp(zw * pulse * 2.1 * activityAmt * (0.35 + 0.65 * beta), 0.0, 1.0);\n\
      \tdisp += n * act * 0.05;\n\n\t// Dispersion: only real beta peaks throw points out (beta squared).\n\tvec3 jitter =\
      \ hash3(seed * 512.0 + 3.0);\n\tfloat burst = disperseAmt * beta * beta;\n\tdisp += jitter * burst * 0.30 * (0.35 +\
      \ 0.65 * seed);\n\n\tvec3 pFinal = p + disp;\n\tP[id] = pFinal;\n\n\tvec3 toCam = normalize(camPos - pFinal);\n\tfloat\
      \ facing = dot(n, toCam);\n\n\t// CUE 1: the back face disappears. A point facing away from the camera is not dimmed,\n\
      \t// it is not drawn at all. With no visible back face there are no longer two possible\n\t// readings of the rotation\
      \ direction.\n\tif (facing < 0.02 * depthFade) {\n\t\tColor[id] = vec4(0.0);\n\t\treturn;\n\t}\n\tfloat faceMask = smoothstep(0.0,\
      \ 0.30, facing);\n\n\t// CUE 2: distance to the camera. Near is bright, far is dark, monotonically, which\n\t// gives\
      \ a readable depth order during the rotation.\n\tfloat camRadius = length(camPos);\n\tfloat dist01 = clamp((length(pFinal\
      \ - camPos) - (camRadius - 1.35)) / 2.70, 0.0, 1.0);\n\tfloat depthCue = mix(1.0, 0.15 + 0.85 * (1.0 - dist01) * (1.0\
      \ - dist01), depthFade);\n\n\t// CUE 3: lighting. A warm key top-left, a cool fill on the other side, Fresnel on the\n\
      \t// rims. The model turns with the object, so it confirms the rotation direction instead\n\t// of leaving it floating.\n\
      \tvec3 keyDir = normalize(vec3(-0.45, 0.75, 0.50));\n\tvec3 fillDir = normalize(vec3(0.65, -0.25, 0.30));\n\tfloat key\
      \ = max(dot(n, keyDir), 0.0);\n\tfloat fill = max(dot(n, fillDir), 0.0);\n\tfloat fresnel = pow(1.0 - clamp(facing,\
      \ 0.0, 1.0), 2.2);\n\tfloat shade = 0.18 + 0.92 * key + 0.22 * fill + 0.85 * fresnel;\n\n\t// Palette: pale pink dominant,\
      \ light violet detail, amber activity focus.\n\tvec3 rose = vec3(1.00, 0.62, 0.78);\n\tvec3 violet = vec3(0.74, 0.55,\
      \ 0.98);\n\tvec3 amber = vec3(1.00, 0.66, 0.20);\n\n\t// Violet marks the sulci -- where the normal turns away from\
      \ the key light -- while\n\t// the ridges stay pink.\n\tfloat violetMix = clamp(violetAmt * (0.25 * seed + 1.25 * (1.0\
      \ - key)), 0.0, 1.0);\n\tvec3 col = mix(rose, violet, violetMix);\n\tcol = mix(col, amber, smoothstep(0.02, 0.55, act));\n\
      \n\tfloat bright = 0.030 + 0.055 * breath * (0.35 + 0.65 * alpha);\n\tbright *= shade;\n\tbright *= 0.70 + 0.60 * seed;\n\
      \tbright *= mix(1.0, 0.03 + 0.97 * faceMask, depthFade) * depthCue;\n\tbright += act * 0.26 * mix(1.0, 0.25 + 0.75 *\
      \ faceMask, depthFade);\n\n\t// Alpha = the strongest channel of the emitted colour. Premultiplied, so a dark point\n\
      \t// never occludes the background: no black halo around the brain.\n\tvec3 rgb = col * bright;\n\tfloat a = clamp(max(max(rgb.r,\
      \ rgb.g), rgb.b), 0.0, 1.0);\n\tColor[id] = vec4(rgb, a);\n}\n"
    dat_content_format: text
  annotations:
  - name: annotate
    mode: annotate
    title: Cloud pulsation
    text: A single GLSL POP displaces and colours every point on the GPU. Breathing along the normal phase-shifted by each
      point's seed, one amber activity focus travelling through the volume, back-face removal and depth dimming. The shader
      is externalized under project1/fx_pulse/.
    position:
    - -70
    - -470
    size:
    - 1070
    - 730
    color:
    - 0.45
    - 0.45
    - 0.45
- name: bg_aurora
  type: baseCOMP
  custom_pars:
    Custom:
    - name: Auroraspeed
      style: Float
      startSection: true
      default: 0.08
      clampMin: true
      clampMax: true
      help: Drift speed of the background veils. Zero freezes them completely.
      value: 1
    - name: Auroralevel
      style: Float
      default: 0.12
      clampMin: true
      clampMax: true
      help: Background brightness. Raising it brings the field forward behind the brain.
      value: 1
  position:
  - 2400
  - -1600
  children:
  - name: out1
    type: outTOP
    position:
    - 1800
    - 0
    inputs:
    - comp_falloff
  - name: comp_veils
    type: compositeTOP
    parameters:
      operand: add
    position:
    - 400
    - 0
    inputs:
    - noise_veil
    - noise_detail
  - name: noise_veil
    type: noiseTOP
    parameters:
      period: 4.5
      harmon: 3
      sx: 0.45
      sy: 1.15
      t4d: =absTime.seconds * parent().par.Auroraspeed.eval() * 0.22
  - name: level_shape
    type: levelTOP
    parameters:
      brightness1: =0.55 + parent().par.Auroralevel.eval() * 1.3
      inlow: 0.22
      inhigh: 0.95
      outhigh: 0.5
    position:
    - 600
    - 0
    inputs:
    - comp_veils
  - name: comp_falloff
    type: compositeTOP
    position:
    - 1400
    - 0
    inputs:
    - lookup_palette
    - circle_falloff
  - name: noise_detail
    type: noiseTOP
    parameters:
      period: 1.1
      amp: 0.12
      offset: 0
      sx: 0.8
      sy: 0.8
      t4d: =absTime.seconds * parent().par.Auroraspeed.eval() * 0.30 + 17.0
    position:
    - 0
    - -400
  - name: ramp_palette
    type: rampTOP
    parameters:
      dat: ramp_palette_keys
      color1: 0.52
      color2: 0.76
      color3: 0.95
    position:
    - 600
    - -400
  - name: circle_falloff
    type: circleTOP
    parameters:
      radiusx: 0.85
      radiusy: 0.85
      fillcolorr: 0.42
      fillcolorg: 0.42
      fillcolorb: 0.42
      bgcolorr: 1
      bgcolorg: 1
      bgcolorb: 1
      bgalpha: 1
      softness: 1.6
      outputresolution: custom
      resolutionw: 1280
      resolutionh: 720
    position:
    - 1000
    - -400
    size:
    - 130
    - 90
    color:
    - 0.67
    - 0.67
    - 0.67
  - name: lookup_palette
    type: lookupTOP
    parameters:
      channel: luminance
    position:
    - 1000
    - 0
    size:
    - 130
    - 90
    color:
    - 0.67
    - 0.67
    - 0.67
    inputs:
    - level_shape
    - ramp_palette
  - name: ramp_palette_keys
    type: tableDAT
    flags:
    - viewer
    - -showDocked
    position:
    - 600
    - -520
    color:
    - 0.67
    - 0.67
    - 0.67
    dock: ramp_palette
    dat_content:
    - - pos
      - r
      - g
      - b
      - a
    - - '0'
      - '0.006'
      - '0.016'
      - '0.045'
      - '1'
    - - '0.45'
      - '0.020'
      - '0.050'
      - '0.100'
      - '1'
    - - '0.75'
      - '0.045'
      - '0.115'
      - '0.205'
      - '1'
    - - '0.92'
      - '0.100'
      - '0.210'
      - '0.330'
      - '1'
    - - '1'
      - '0.170'
      - '0.320'
      - '0.470'
      - '1'
    dat_content_format: table
  annotations:
  - name: annotate
    mode: annotate
    title: Aurora background
    text: Two layers of 4D simplex noise evolving in place (never scrolling), summed, stretched across their real range, then
      mapped into the deep navy to sky blue palette. Auroraspeed drives the drift, Auroralevel the brightness. A hard output
      ceiling keeps the background darker than the brain at every phase of the noise.
    position:
    - -70
    - -590
    size:
    - 1670
    - 850
    color:
    - 0.45
    - 0.45
    - 0.45
- name: composite
  type: baseCOMP
  custom_pars:
    Custom:
    - name: Persistence
      style: Float
      startSection: true
      default: 0.8
      max: 0.95
      clampMin: true
      clampMax: true
      normMax: 0.95
      help: Length of the trails behind the points. High stretches the comet; beyond that the shape drowns.
    - name: Glow
      style: Float
      default: 0.7
      clampMin: true
      clampMax: true
      help: Halo around the most intense points.
      value: 1
